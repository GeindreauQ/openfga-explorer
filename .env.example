# ─── Server ───────────────────────────────────────────────────────────────────
ADDR=:8000
WEB_DIR=../web

# ─── OpenFGA ──────────────────────────────────────────────────────────────────
# URL de l'instance OpenFGA, vue depuis le conteneur.
# Le store actif n'est PAS configuré ici : le binaire liste tous les stores
# disponibles sur cette URL au boot et le serveur démarre avec le premier par
# défaut. L'opérateur peut changer de store à chaud depuis le sélecteur
# dans la barre d'outils de l'UI.
OPENFGA_URL=http://openfga:8080

# Bearer token optionnel (utile si OpenFGA est derrière un proxy d'auth).
# Sans préfixe "Bearer" : le binaire l'ajoute si absent.
OPENFGA_TOKEN=

# ─── Auth (OIDC) ──────────────────────────────────────────────────────────────
# Authentification gérée par couches :
#   1. OIDC (optionnel) : si OIDC_ISSUER_URL est défini, l'UI redirige vers
#      le provider OpenID Connect (Keycloak, Auth0, Okta, etc.).
#   2. Login local (toujours actif) : form username/password sur /login.
#      Un compte admin est seedé au boot si absent (cf. AdminPassword).
#   3. AUTH_DISABLED=1 : désactive TOUTE l'auth (mode démo, accès direct
#      à l'UI sans aucune authentification).

# URL du provider OIDC (ex: Keycloak realm : http://keycloak:8080/realms/demo)
OIDC_ISSUER_URL=

# Client ID et Secret enregistrés sur le provider.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# URL de callback (doit correspondre à celle déclarée côté provider).
# En local : http://localhost:8000/auth/callback
OIDC_REDIRECT_URL=http://localhost:8000/auth/callback

# Scopes OAuth2 demandés (séparés par des virgules).
OIDC_SCOPES=openid,profile,email

# Clé HMAC pour signer les cookies de session. MIN 32 caractères.
# En production, fournir une vraie valeur aléatoire (sealed-secrets, etc.).
SESSION_SECRET=dev-only-insecure-change-me

# Mot de passe du compte admin par défaut (login local).
# Si vide, un mot de passe de 24 caractères est généré aléatoirement
# et imprimé dans les logs au démarrage. Pour la production, fournir
# un secret stable (k8s secret, vault) pour éviter de dépendre
# du scraping des logs.
ADMIN_PASSWORD=

# AUTH_DISABLED=1 désactive toute auth (mode démo).
# Par défaut (vide ou 0), auth requise : OIDC si configuré, sinon local.
AUTH_DISABLED=

# ─── Cookies & Rate limit ─────────────────────────────────────────────────────
# SECURE_COOKIES=1 pose l'attribut Secure sur les cookies de session
# (à activer en production derrière HTTPS). En dev (HTTP), laisser vide
# sinon le navigateur refusera le cookie. Pas d'auto-détection : c'est
# à l'opérateur de décider selon son déploiement.
SECURE_COOKIES=

# RATE_LIMIT_PER_MIN : nombre max de POST /auth/local par minute par IP.
# Anti brute-force sur le login local. Défaut : 50. Au-delà, le serveur
# renvoie HTTP 429 avec Retry-After=60.
RATE_LIMIT_PER_MIN=50