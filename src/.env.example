# Configuration du serveur OpenFGA Explorer.
# Copie ce fichier en `.env` dans src/server/ (ou exporte les variables).

# Adresse d'écoute du serveur HTTP.
ADDR=:8000

# Dossier des fichiers statiques du frontend (relatif au binaire serveur).
WEB_DIR=../web

# ── Connexion OpenFGA ──────────────────────────────────────────────────────
# URL de base de l'instance OpenFGA.
# Le store actif est sélectionné depuis l'UI au démarrage (premier store
# disponible par défaut) et modifiable à chaud via le sélecteur en barre
# d'outils.
OPENFGA_URL=http://localhost:8080

# Bearer token optionnel (sans le préfixe "Bearer", il est ajouté si absent).
OPENFGA_TOKEN=